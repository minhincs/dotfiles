#!/usr/bin/env bash
set -eu

helper=$(dirname "$0")/master-ratio-extent
check() {
  local focus=$1 delta=$2 expected=$3 actual
  actual=$(MOCK_FOCUS="$focus" bash -c '
    umbriel() {
      case "$1" in
        workspaces) printf "[{\"id\":\"ws1\",\"focused\":true,\"layout\":\"master\"}]\n" ;;
        windows)
          if [[ $MOCK_FOCUS == master ]]; then
            printf "[{\"workspace\":\"ws1\",\"floating\":false,\"focused\":true,\"x\":0},{\"workspace\":\"ws1\",\"floating\":false,\"focused\":false,\"x\":500}]\n"
          else
            printf "[{\"workspace\":\"ws1\",\"floating\":false,\"focused\":false,\"x\":0},{\"workspace\":\"ws1\",\"floating\":false,\"focused\":true,\"x\":500}]\n"
          fi
          ;;
        msg) printf "%s\n" "$2" ;;
      esac
    }
    . "$1" "$2"
  ' _ "$helper" "$delta")
  [[ $actual == "$expected" ]] || { printf 'got %s, wanted %s\n' "$actual" "$expected" >&2; exit 1; }
}

check master 0.05 window-modify-primary-extent:0.05
check stack 0.05 window-modify-primary-extent:-0.05
check master -0.05 window-modify-primary-extent:-0.05
check stack -0.05 window-modify-primary-extent:0.05
printf 'master-ratio-extent: ok\n'
